    "mcp",
    "model-context-protocol",
    "vedic-astrology",
    "jyotish",
    "panchang",
    "kundali",
    "muhurat",
    "swiss-ephemeris",
    "astronomy",
    "hindu-calendar",
    "claude",
    "anthropic",
    "llm-tools"
  ],
  "homepage": "https://dekhopanchang.com/mcp",
  "repository": {
    "type": "git",
    "url": "https://github.com/krazykrackpot/panchang.git",
    "directory": "packages/mcp-server"
  },
  "bugs": {
    "url": "https://github.com/krazykrackpot/panchang/issues"
  },
  "license": "MIT",
  "author": "Dekho Panchang <hello@dekhopanchang.com>",
  "type": "module",
  "main": "dist/packages/mcp-server/src/index.js",
  "types": "dist/packages/mcp-server/src/index.d.ts",
  "bin": {
    "dekhopanchang-mcp": "dist/packages/mcp-server/src/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json --resolve-full-paths",
    "typecheck": "tsc -p tsconfig.json --noEmit",
